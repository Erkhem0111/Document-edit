# Энэ файлыг .env болгож хуулаад утгуудыг бөглөнө. Жинхэнэ нууц үгийг энд бүү бич.

# Өгөгдлийн сан (docker-compose.yml мөн эндээс уншина)
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=company_system
DATABASE_URL="postgresql://admin:<POSTGRES_PASSWORD>@localhost:5432/company_system?schema=public"

# Нэвтрэлт
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Хамтын засвар
LIVEBLOCKS_SECRET_KEY=

# Файл хадгалах (Cloudflare R2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=
R2_REGION=auto
# R2_QUOTA_BYTES=

# Имэйл (Resend)
RESEND_API_KEY=
EMAIL_FROM="TLS Workspace <noreply@terraline.mn>"
APP_URL=http://localhost:3000

# AI багц (заавал биш)
# AI_PACKAGE_CONTACT_EMAIL=
# AI_PACKAGE_PRICE_MNT=
# AI_PACKAGE_ENABLED=false
# ANTHROPIC_API_KEY=
